# Used by Phase 3 (AI-assisted ranking, ranking_mode: ai in config.yaml).
# Copy to .env and fill in only the key for whichever ai.provider you use —
# jobscout/__main__.py loads .env automatically via python-dotenv.

# Default provider (ai.provider: gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative provider (ai.provider: anthropic). https://console.anthropic.com/
ANTHROPIC_API_KEY=
